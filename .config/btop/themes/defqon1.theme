# ==============================================================================
# Btop Theme - Defqon.1 Weekend Warrior (Industrial Dark)
# ==============================================================================

# Main background, empty for terminal default, "theme[main_bg]"
theme[main_bg]="#0e1015"

# Main text color
theme[main_fg]="#f1f5f9"

# Title color for boxes
theme[title]="#dc2626"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f97316"

# Background color of selected item in processes box
theme[selected_bg]="#242733"

# Foreground color of selected item in processes box
theme[selected_fg]="#f59e0b"

# Color of inactive/disabled text
theme[inactive_fg]="#5c6370"

# Color of text appearing on top of graphs, i.e uptime and current network
theme[graph_text]="#cbd5e1"

# Background color of the meter box
theme[meter_bg]="#151821"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#06b6d4"

# Box divider line and border color
theme[cpu_box]="#282c37"
theme[mem_box]="#282c37"
theme[net_box]="#282c37"
theme[proc_box]="#282c37"
theme[div_line]="#1f232c"

# Temperature graph colors
theme[temp_start]="#84cc16"
theme[temp_mid]="#f97316"
theme[temp_end]="#ef4444"

# CPU graph colors (Pyro Flame Gradient)
theme[cpu_start]="#f59e0b"
theme[cpu_mid]="#f97316"
theme[cpu_end]="#dc2626"

# Mem & Disk free meter
theme[free_start]="#84cc16"
theme[free_mid]="#f59e0b"
theme[free_end]="#f97316"

# Mem & Disk cached meter
theme[cached_start]="#06b6d4"
theme[cached_mid]="#38bdf8"
theme[cached_end]="#dc2626"

# Mem & Disk available meter
theme[available_start]="#84cc16"
theme[available_mid]="#f59e0b"
theme[available_end]="#dc2626"

# Mem & Disk used meter
theme[used_start]="#84cc16"
theme[used_mid]="#f97316"
theme[used_end]="#ef4444"

# Download graph colors
theme[download_start]="#06b6d4"
theme[download_mid]="#38bdf8"
theme[download_end]="#dc2626"

# Upload graph colors
theme[upload_start]="#84cc16"
theme[upload_mid]="#f97316"
theme[upload_end]="#ef4444"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#f59e0b"
theme[process_mid]="#f97316"
theme[process_end]="#dc2626"
