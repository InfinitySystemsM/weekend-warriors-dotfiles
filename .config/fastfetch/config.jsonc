{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "sixel",
        "source": "/home/infinity/.config/fastfetch/defqon_white.png",
        "width": 18,
        "preserveAspectRatio": true,
        "padding": {
            "top": 0,
            "right": 2
        }
    },
    "display": {
        "separator": " 󰅂 ",
        "color": {
            "keys": "#e05561",
            "title": "#f38d41"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored} {##e05561}• {##f38d41}Defqon.1 Weekend Warrior{#}"
        },
        {
            "type": "separator",
            "times": 52
        },
        {
            "type": "os",
            "key": "󰣇 OS"
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime"
        },
        {
            "type": "shell",
            "key": "󰞷 Shell"
        },
        {
            "type": "wm",
            "key": "󱂬 WM"
        },
        {
            "type": "cpu",
            "key": "󰍛 CPU"
        },
        {
            "type": "memory",
            "key": "󰘚 Memory"
        },
        "break",
        "colors"
    ]
}
