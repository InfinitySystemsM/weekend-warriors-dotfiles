# ==============================================================================
# Micro Colorscheme - Defqon.1 Weekend Warrior (Industrial Dark)
# ==============================================================================

color-link default "#f1f5f9,#0e1015"
color-link comment "#5c6370"

color-link identifier "#06b6d4"
color-link identifier.class "#06b6d4"
color-link identifier.var "#06b6d4"

color-link constant "#f97316"
color-link constant.number "#f97316"
color-link constant.string "#84cc16"

color-link symbol "#dc2626"
color-link symbol.brackets "#f1f5f9"
color-link symbol.tag "#06b6d4"

color-link type "#38bdf8"
color-link type.keyword "#f59e0b"

color-link special "#ef4444"
color-link statement "#dc2626"
color-link preproc "#f59e0b"

color-link underlined "#06b6d4"
color-link error "bold #ef4444"
color-link todo "bold #f97316"

color-link diff-added "#84cc16"
color-link diff-modified "#f59e0b"
color-link diff-deleted "#ef4444"

color-link gutter-error "#ef4444"
color-link gutter-warning "#f97316"

color-link statusline "#f1f5f9,#151821"
color-link tabbar "#7d8597,#151821"
color-link indent-char "#282c37"
color-link line-number "#5c6370,#151821"
color-link current-line-number "#dc2626,#151821"

color-link cursor-line "#151821"
color-link color-column "#151821"
color-link divider "#282c37"
color-link type.extended "default"
