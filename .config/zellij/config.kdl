// ==============================================================================
// Zellij Configuration - Defqon.1 Weekend Warrior (Industrial Dark)
// ==============================================================================

theme "defqon1"
default_layout "default"
mouse_mode true
copy_on_select true
pane_frames true
simplified_ui false
default_shell "fish"

themes {
    defqon1 {
        bg "#242731"
        fg "#e4e5e8"
        red "#e05561"
        green "#8ebd6b"
        blue "#61afef"
        yellow "#e5c07b"
        magenta "#e05561"
        orange "#f38d41"
        cyan "#56b6c2"
        black "#121317"
        white "#e4e5e8"
    }
}
