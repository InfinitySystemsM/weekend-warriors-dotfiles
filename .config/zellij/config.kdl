// ==============================================================================
// Zellij Configuration - Defqon.1 Weekend Warrior (Industrial Dark)
// ==============================================================================

theme "defqon1"
default_layout "default"
mouse_mode true
copy_on_select true
pane_frames true
simplified_ui false
default_shell "fish"

themes {
    defqon1 {
        bg "#242733"
        fg "#f1f5f9"
        red "#dc2626"
        green "#84cc16"
        blue "#38bdf8"
        yellow "#f59e0b"
        magenta "#dc2626"
        orange "#f97316"
        cyan "#06b6d4"
        black "#0e1015"
        white "#f1f5f9"
    }
}
