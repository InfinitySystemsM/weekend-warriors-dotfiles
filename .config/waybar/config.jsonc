{
    "layer": "top",
    "position": "top",
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,

    "modules-left": [
        "sway/workspaces",
        "custom/left-arrow-workspaces",
        "sway/mode",
        "sway/window",
        "custom/left-arrow-window"
    ],
    "modules-center": [
        "custom/clock-arrow-left",
        "clock",
        "custom/clock-arrow-right"
    ],
    "modules-right": [
        "custom/arrow-updates",
        "custom/updates",
        "custom/arrow-cpu",
        "cpu",
        "custom/arrow-memory",
        "memory",
        "custom/arrow-disk",
        "disk",
        "custom/arrow-pulseaudio",
        "pulseaudio",
        "custom/arrow-network",
        "network",
        "custom/arrow-tray",
        "tray",
        "custom/arrow-power",
        "custom/power"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "custom/left-arrow-workspaces": {
        "format": "",
        "tooltip": false
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "sway/window": {
        "format": "{title}",
        "max-length": 40,
        "rewrite": {
            "(.*) - foot": "  $1",
            "(.*) — Mozilla Firefox": "󰈹  $1",
            "^Terminal$": "  Terminal",
            "^$": "  Desktop"
        }
    },

    "custom/left-arrow-window": {
        "format": "",
        "tooltip": false
    },

    "custom/clock-arrow-left": {
        "format": "",
        "tooltip": false
    },

    "clock": {
        "interval": 1,
        "format": "  {:%H:%M:%S   󰃭  %a %d %b}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#e05561'><b>{}</b></span>",
                "days": "<span color='#e4e5e8'><b>{}</b></span>",
                "weeks": "<span color='#56b6c2'><b>W{}</b></span>",
                "weekdays": "<span color='#f38d41'><b>{}</b></span>",
                "today": "<span color='#ff4757'><b><u>{}</u></b></span>"
            }
        },
        "on-click": "foot --app-id=tui-calendar -e tui-calendar"
    },

    "custom/clock-arrow-right": {
        "format": "",
        "tooltip": false
    },

    "custom/arrow-updates": {
        "format": "",
        "tooltip": false
    },

    "custom/updates": {
        "format": "{}",
        "interval": 1800,
        "return-type": "json",
        "exec": "~/.local/bin/check-updates",
        "on-click": "foot --app-id=tui-updates -e system-update",
        "signal": 8
    },

    "custom/arrow-cpu": {
        "format": "",
        "tooltip": false
    },

    "cpu": {
        "interval": 2,
        "format": "  {usage}%",
        "on-click": "foot --app-id=tui-btop -e btop"
    },

    "custom/arrow-memory": {
        "format": "",
        "tooltip": false
    },

    "memory": {
        "interval": 2,
        "format": "󰘚  {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB",
        "on-click": "foot --app-id=tui-btop -e btop"
    },

    "custom/arrow-disk": {
        "format": "",
        "tooltip": false
    },

    "disk": {
        "interval": 30,
        "format": "󰋊  {percentage_used}%",
        "path": "/"
    },

    "custom/arrow-pulseaudio": {
        "format": "",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "foot --app-id=tui-pulsemixer -e pulsemixer"
    },

    "custom/arrow-network": {
        "format": "",
        "tooltip": false
    },

    "network": {
        "interval": 5,
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰤭  Offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "fuzzel-wifi"
    },

    "custom/arrow-tray": {
        "format": "",
        "tooltip": false
    },

    "tray": {
        "icon-size": 15,
        "spacing": 6,
        "show-passive-items": true
    },

    "custom/arrow-power": {
        "format": "",
        "tooltip": false
    },

    "custom/power": {
        "format": " ",
        "tooltip": false,
        "on-click": "fuzzel-powermenu"
    }
}
