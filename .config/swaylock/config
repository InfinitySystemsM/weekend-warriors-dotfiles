# ==============================================================================
# Swaylock-Effects Configuration - Defqon.1 Weekend Warrior (Industrial Dark)
# ==============================================================================

# Daemon & Authentication
daemonize
ignore-empty-password
show-failed-attempts

# Typography & Font
font=MesloLGS Nerd Font

# Digital Clock Display
clock
timestr=%H:%M
datestr=

# Background / Blur Effects
screenshots
effect-blur=7x5
effect-vignette=0.5:0.5

# Indicator Ring Geometry
indicator
indicator-radius=115
indicator-thickness=9

# Colors: Defqon.1 Industrial Palette
# Inner Circle Background
inside-color=181a20ff
inside-clear-color=181a20ff
inside-caps-lock-color=181a20ff
inside-ver-color=181a20ff
inside-wrong-color=181a20ff

# Ring Border (Warrior Red #e05561)
ring-color=e05561ff
ring-clear-color=f38d41ff
ring-caps-lock-color=e5c07bff
ring-ver-color=8ebd6bff
ring-wrong-color=ff4757ff

# Keypress Highlights (Flame Amber #f38d41)
key-hl-color=f38d41ff
bs-hl-color=ff4757ff
caps-lock-key-hl-color=e5c07bff
caps-lock-bs-hl-color=ff4757ff

# Separators & Dividing Lines
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000

# Text Labels
text-color=e4e5e8ff
text-clear-color=f38d41ff
text-caps-lock-color=e5c07bff
text-ver-color=8ebd6bff
text-wrong-color=ff4757ff
