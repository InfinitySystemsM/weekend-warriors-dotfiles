# ==============================================================================
# Swaylock-Effects Configuration - Defqon.1 Weekend Warrior (Industrial Dark)
# ==============================================================================

# Daemon & Authentication
daemonize
ignore-empty-password
show-failed-attempts

# Typography & Font
font=Terminess Nerd Font

# Digital Clock Display
clock
timestr=%H:%M
datestr=

# Background / Blur Effects
screenshots
effect-blur=7x5
effect-vignette=0.5:0.5

# Indicator Ring Geometry
indicator
indicator-radius=115
indicator-thickness=9

# Colors: Defqon.1 RED Mainstage (Sun Halo & Flame Accents)
# Inner Circle Background
inside-color=151821ff
inside-clear-color=151821ff
inside-caps-lock-color=151821ff
inside-ver-color=151821ff
inside-wrong-color=151821ff

# Ring Border (Defqon Red #dc2626)
ring-color=dc2626ff
ring-clear-color=f97316ff
ring-caps-lock-color=f59e0bff
ring-ver-color=84cc16ff
ring-wrong-color=ef4444ff

# Keypress Highlights (Solar Gold #f59e0b & Pyro Orange #f97316)
key-hl-color=f59e0bff
bs-hl-color=ef4444ff
caps-lock-key-hl-color=f59e0bff
caps-lock-bs-hl-color=ef4444ff

# Separators & Dividing Lines
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000

# Text Labels
text-color=f1f5f9ff
text-clear-color=f97316ff
text-caps-lock-color=f59e0bff
text-ver-color=84cc16ff
text-wrong-color=ef4444ff
