# ==============================================================================
# Swaylock-Effects Configuration - Catppuccin Mocha & Ly-DM Consistency
# ==============================================================================

# Daemon & Authentication
daemonize
ignore-empty-password
show-failed-attempts

# Typography & Font
font=MesloLGS Nerd Font

# Digital Clock Display (Ly-DM Consistency)
clock
timestr=%H:%M
datestr=

# Background / Blur Effects
screenshots
effect-blur=7x5
effect-vignette=0.5:0.5

# Indicator Ring Geometry
indicator
indicator-radius=115
indicator-thickness=9

# Colors: Catppuccin Mocha (Ly-DM Consistent Palette)
# Inner Circle Background
inside-color=1e1e2eff
inside-clear-color=1e1e2eff
inside-caps-lock-color=1e1e2eff
inside-ver-color=1e1e2eff
inside-wrong-color=1e1e2eff

# Ring Border (Mauve #cba6f7 - matching Ly-DM box borders)
ring-color=cba6f7ff
ring-clear-color=fab387ff
ring-caps-lock-color=f9e2afff
ring-ver-color=89b4faff
ring-wrong-color=f38ba8ff

# Keypress Highlights (Green #a6e3a1 - matching Ly-DM Matrix green)
key-hl-color=a6e3a1ff
bs-hl-color=f38ba8ff
caps-lock-key-hl-color=f9e2afff
caps-lock-bs-hl-color=f38ba8ff

# Separators & Dividing Lines
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000

# Text Labels (Catppuccin Text #cdd6f4)
text-color=cdd6f4ff
text-clear-color=fab387ff
text-caps-lock-color=f9e2afff
text-ver-color=89b4faff
text-wrong-color=f38ba8ff
