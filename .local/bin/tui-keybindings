# ------------------------------------------------------------------------------
# Modo Fuzzel: Búsqueda rápida emergente
# ------------------------------------------------------------------------------
run_fuzzel() {
    local list=""
    for item in "${BINDINGS[@]}"; do
        IFS='|' read -r cat key desc cmd long_desc <<< "$item"
        list="$list$cat  ❯  $key  •  $desc\n"
    done

    local chosen=$(echo -e "$list" | fuzzel --dmenu --prompt="⌨️ Atajos ❯ " --width=70 --lines=15)
    [ -z "$chosen" ] && exit 0

    local selected_key=$(echo "$chosen" | awk -F'  ❯  ' '{print $2}' | awk -F'  •  ' '{print $1}')
    
    # Buscar el comando correspondiente
    for item in "${BINDINGS[@]}"; do
        IFS='|' read -r cat key desc cmd long_desc <<< "$item"
        if [ "$key" = "$selected_key" ]; then
            if [[ "$cmd" == *"swaymsg workspace"* ]] || [[ "$cmd" == *"swaymsg focus"* ]] || [[ "$cmd" == *"swaymsg move"* ]]; then
                if command -v wl-copy >/dev/null 2>&1; then
                    echo -n "$key" | wl-copy
                fi
                notify-send -u low -t 3000 \
                    -h string:x-canonical-private-synchronous:keybind \
                    "⌨️ Atajo de Teclado" "$key: $desc\n(Copiado al portapapeles)"
            else
                notify-send -u low -t 2000 \
                    -h string:x-canonical-private-synchronous:keybind \
                    "⌨️ Ejecutando Atajo" "$key ❯ $desc"
                eval "$cmd" &
            fi
            break
        fi
    done
}

# ------------------------------------------------------------------------------
# Generador de Vista Previa para FZF
# ------------------------------------------------------------------------------
preview_keybind() {
    local target="$1"
    for item in "${BINDINGS[@]}"; do
        IFS='|' read -r cat key desc cmd long_desc <<< "$item"
        local match_str="$cat  •  $key"
        if [[ "$match_str" == *"$target"* ]] || [[ "$key" == "$target" ]]; then
            echo -e "\033[1;31m╔════════════════════════════════════════════════════════════════╗\033[0m"
            echo -e "\033[1;31m║\033[0m  \033[1;33m🛡️  DEFQON.1 • GUÍA DE ATAJOS DE TECLADO (SWAY WM)\033[0m           \033[1;31m║\033[0m"
            echo -e "\033[1;31m╚════════════════════════════════════════════════════════════════╝\033[0m"
            echo ""
            echo -e " \033[1;36mCategoría:\033[0m        $cat"
            echo -e " \033[1;31mAtajo:\033[0m            \033[1;33;40m $key \033[0m"
            echo -e " \033[1;32mAcción:\033[0m           $desc"
            echo ""
            echo -e "\033[1;35m────────────────────────────────────────────────────────────────\033[0m"
            echo -e " \033[1;34mDescripción Detallada:\033[0m"
            echo -e " $long_desc"
            echo ""
            echo -e " \033[1;34mComando Ejecutado:\033[0m"
            echo -e " \033[0;36m$cmd\033[0m"
            echo -e "\033[1;35m────────────────────────────────────────────────────────────────\033[0m"
            echo ""
            echo -e " \033[1;33m💡 Consejo:\033[0m Pulsa \033[1;32m[Enter]\033[0m para probar la acción o copiar el atajo."
            return
        fi
    done
}

# ------------------------------------------------------------------------------
# Modo TUI: FZF Dashboard en Pantalla Completa / Floating
# ------------------------------------------------------------------------------
run_tui() {
    clear
    local fzf_items=""
    for item in "${BINDINGS[@]}"; do
        IFS='|' read -r cat key desc cmd long_desc <<< "$item"
        printf -v line "%-18s │ %-32s │ %s" "$cat" "$key" "$desc"
        fzf_items="$fzf_items$line\n"
    done

    export SCRIPT_SELF="$0"

    selected=$(echo -e "$fzf_items" | fzf \
        --border=sharp \
        --header="DEFQON.1 KEYBINDINGS CHEAT SHEET  |  [Enter]: Ejecutar/Copiar  |  [ESC]: Salir  |  [Escribir]: Filtrar" \
        --prompt="⌨️ Buscar Atajo ❯ " \
        --preview="$SCRIPT_SELF --preview {2}" \
        --preview-window="right:52%:wrap")

    if [ -n "$selected" ]; then
        # Extraer key
        local raw_key=$(echo "$selected" | awk -F'│' '{print $2}' | xargs)
        for item in "${BINDINGS[@]}"; do
            IFS='|' read -r cat key desc cmd long_desc <<< "$item"
            if [ "$key" = "$raw_key" ]; then
                if [[ "$cmd" == *"swaymsg workspace"* ]] || [[ "$cmd" == *"swaymsg focus"* ]] || [[ "$cmd" == *"swaymsg move"* ]]; then
                    if command -v wl-copy >/dev/null 2>&1; then
                        echo -n "$key" | wl-copy
                    fi
                    notify-send -u low -t 3000 \
                        -h string:x-canonical-private-synchronous:keybind \
                        "⌨️ Atajo de Teclado" "$key: $desc\n(Copiado al portapapeles)"
                else
                    eval "$cmd" &
                fi
                break
            fi
        done
    fi
}

# ------------------------------------------------------------------------------
# Manejador de Parámetros
# ------------------------------------------------------------------------------
case "${1:-}" in
    --fuzzel|-f)
        run_fuzzel
        ;;
    --preview)
        preview_keybind "$2"
        ;;
    --help|-h)
        echo "Uso: $0 [--fuzzel | --tui]"
        echo "  --fuzzel    Abre el menú interactivo en Fuzzel"
        echo "  --tui       Abre la guía visual en terminal interactivo con FZF (por defecto)"
        ;;
    *)
        run_tui
        ;;
esac
