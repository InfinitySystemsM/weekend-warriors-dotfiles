#!/usr/bin/env bash
# ==============================================================================
# Screenshot Utility for Sway & Wayland (Clipboard Only + Notification)
# ==============================================================================

TMP_IMG=$(mktemp --suffix=.png /tmp/screenshot_XXXXXX)
trap 'rm -f "$TMP_IMG"' EXIT

mode="${1:-full}"

case "$mode" in
    full)
        grim "$TMP_IMG"
        if [ -f "$TMP_IMG" ]; then
            wl-copy --type image/png < "$TMP_IMG"
            notify-send -i "$TMP_IMG" -a "Captura" "Captura de Pantalla Completa" "Copiada directamente al portapapeles"
        fi
        ;;
    area)
        # Interactive area selection with slurp (styled in Defqon.1 Warrior Red)
        GEOM=$(slurp -d -b "#12131788" -c "#e05561ff" -s "#e0556133" -w 2 2>/dev/null)
        if [ -n "$GEOM" ]; then
            grim -g "$GEOM" "$TMP_IMG"
            if [ -f "$TMP_IMG" ]; then
                wl-copy --type image/png < "$TMP_IMG"
                notify-send -i "$TMP_IMG" -a "Captura" "Captura de Área Seleccionada" "Copiada directamente al portapapeles"
            fi
        fi
        ;;
    window)
        # Active focused window capture
        GEOM=$(swaymsg -t get_tree | jq -r '.. | select(.focused?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' 2>/dev/null)
        if [ -n "$GEOM" ]; then
            grim -g "$GEOM" "$TMP_IMG"
            if [ -f "$TMP_IMG" ]; then
                wl-copy --type image/png < "$TMP_IMG"
                notify-send -i "$TMP_IMG" -a "Captura" "Captura de Ventana Activa" "Copiada directamente al portapapeles"
            fi
        fi
        ;;
    *)
        options="󰹑  [1] Pantalla Completa\n󰆞  [2] Selección de Área\n󰍹  [3] Ventana Activa"
        chosen=$(echo -e "$options" | fuzzel --dmenu --prompt="󰹑 Captura ❯ " --width=35 --lines=4)
        case "$chosen" in
            *"[1] Pantalla Completa"*) "$0" full ;;
            *"[2] Selección de Área"*) "$0" area ;;
            *"[3] Ventana Activa"*) "$0" window ;;
        esac
        ;;
esac
