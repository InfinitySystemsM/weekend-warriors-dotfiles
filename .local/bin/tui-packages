#!/usr/bin/env bash
# ==============================================================================
# TUI Package Manager (Pacman + AUR via Yay)
# Inspired by Omarchy Linux TUI App Center
# ==============================================================================

HELPER="yay"

# Catppuccin Mocha FZF Theme
export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#b4befe \
--color=marker:#a6e3a1,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 \
--color=border:#cba6f7,preview-border:#89b4fa \
--prompt='󰏖 Buscar paquete ❯ ' \
--pointer='❯' \
--marker='✓' \
--bind 'ctrl-a:select-all,ctrl-d:deselect-all'"

menu() {
    clear
    echo -e "\033[1;35m╔═════════════════════════════════════════════════════════╗\033[0m"
    echo -e "\033[1;35m║\033[0m   \033[1;36m󰏖  GESTOR DE PAQUETES TUI (CachyOS + AUR / Yay)\033[0m       \033[1;35m║\033[0m"
    echo -e "\033[1;35m╚═════════════════════════════════════════════════════════╝\033[0m"
    echo ""
    echo -e " \033[1;34m[1]\033[0m 󰏖  Buscar e Instalar Software (Repos Oficiales + AUR)"
    echo -e " \033[1;34m[2]\033[0m 󰚰  Actualizar Todo el Sistema (yay -Syu)"
    echo -e " \033[1;34m[3]\033[0m 󰆴  Gestionar / Desinstalar Paquetes Instalados"
    echo -e " \033[1;34m[4]\033[0m 󰃢  Limpiar Paquetes Huérfanos y Caché"
    echo -e " \033[1;31m[q]\033[0m 󰍃  Salir"
    echo ""
    read -rp " Selecciona una opción [1-4, q]: " opt

    case "$opt" in
        1) install_packages ;;
        2) update_system ;;
        3) remove_packages ;;
        4) clean_cache ;;
        q|Q) exit 0 ;;
        *) menu ;;
    esac
}

install_packages() {
    clear
    echo -e "\033[1;36mCargando catálogo de paquetes (Repositorios Oficiales + AUR)...\033[0m"
    
    # Generate list from pacman repos and allow live query for AUR
    selected=$(pacman -Slq | sort -u | fzf --multi \
        --border=sharp \
        --header="[TAB] Marcar varios | [ENTER] Instalar | [ESC] Menú" \
        --preview "yay -Si {} 2>/dev/null || yay -Sia {} 2>/dev/null" \
        --preview-window=right:55%:wrap)

    if [ -n "$selected" ]; then
        clear
        echo -e "\033[1;32mPaquetes seleccionados para instalar:\033[0m"
        echo "$selected"
        echo ""
        read -rp "¿Deseas instalar estos paquetes con yay? [S/n]: " confirm
        if [[ "$confirm" =~ ^[sSyY]?$ ]]; then
            yay -S $(echo "$selected" | tr '\n' ' ')
            echo ""
            echo -e "\033[1;32m¡Instalación finalizada con éxito!\033[0m"
            read -rp "Presiona Enter para continuar..."
        fi
    fi
    menu
}

remove_packages() {
    clear
    selected=$(pacman -Qqe | fzf --multi \
        --border=sharp \
        --header="[TAB] Marcar varios | [ENTER] Desinstalar | [ESC] Menú" \
        --preview "pacman -Qi {}" \
        --preview-window=right:55%:wrap)

    if [ -n "$selected" ]; then
        clear
        echo -e "\033[1;31mPaquetes seleccionados para desinstalar:\033[0m"
        echo "$selected"
        echo ""
        read -rp "¿Estás seguro de desinstalar estos paquetes? [S/n]: " confirm
        if [[ "$confirm" =~ ^[sSyY]?$ ]]; then
            sudo pacman -Rns $(echo "$selected" | tr '\n' ' ')
            echo ""
            echo -e "\033[1;32m¡Paquetes desinstalados!\033[0m"
            read -rp "Presiona Enter para continuar..."
        fi
    fi
    menu
}

update_system() {
    clear
    echo -e "\033[1;36mIniciando actualización completa del sistema (Oficiales + AUR)...\033[0m"
    yay -Syu
    echo ""
    read -rp "Presiona Enter para continuar..."
    menu
}

clean_cache() {
    clear
    echo -e "\033[1;33mLimpiando dependencias y paquetes huérfanos con yay...\033[0m"
    yay -Yc --noconfirm 2>/dev/null || true
    echo ""
    echo -e "\033[1;33mLimpiando cache de paquetes...\033[0m"
    yay -Sc --noconfirm
    echo ""
    echo -e "\033[1;32m¡Limpieza completada!\033[0m"
    read -rp "Presiona Enter para continuar..."
    menu
}

# Run menu or direct install mode if arguments provided
if [ $# -eq 0 ]; then
    menu
else
    install_packages
fi
