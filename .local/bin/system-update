#!/usr/bin/env python3
"""
==============================================================================
Defqon.1 Industrial System Updater - CachyOS / Arch Linux
Integrated Pre-Update Arch & CachyOS News Checker and Post-Update Maintenance
==============================================================================
"""

import sys
import os
import subprocess
import urllib.request
import xml.etree.ElementTree as ET
import html
import re
from datetime import datetime

# ANSI Color Codes - Defqon.1 Industrial Theme
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
RED = "\033[1;31m"
AMBER = "\033[1;33m"
GREEN = "\033[1;32m"
CYAN = "\033[1;36m"
GRAY = "\033[0;90m"
WHITE = "\033[1;37m"

STATE_DIR = os.path.expanduser("~/.local/state/cachyos_update")
LAST_NEWS_FILE = os.path.join(STATE_DIR, "last_read_news.txt")

def print_banner():
    print(f"{RED}╔════════════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{RED}║      {AMBER}DEFQON.1 • WEEKEND WARRIORS{RED} - {WHITE}CACHYOS / ARCH SYSTEM UPDATER      {RED}║{RESET}")
    print(f"{RED}╚════════════════════════════════════════════════════════════════════════╝{RESET}\n")

def fetch_arch_news():
    """Fetch recent news from Arch Linux official RSS feed."""
    url = "https://archlinux.org/feeds/news/"
    req = urllib.request.Request(url, headers={"User-Agent": "CachyOS-Defqon-Updater/1.0"})
    news_items = []
    try:
        with urllib.request.urlopen(req, timeout=6) as response:
            xml_data = response.read()
            root = ET.fromstring(xml_data)
            for item in root.findall(".//item"):
                title = item.find("title").text.strip() if item.find("title") is not None else "Sin título"
                pub_date = item.find("pubDate").text.strip() if item.find("pubDate") is not None else ""
                link = item.find("link").text.strip() if item.find("link") is not None else ""
                description = item.find("description").text.strip() if item.find("description") is not None else ""
                
                # Strip basic HTML tags from description
                clean_desc = re.sub(r"<[^>]+>", "", description)
                clean_desc = html.unescape(clean_desc).strip()
                
                news_items.append({
                    "title": title,
                    "date": pub_date,
                    "link": link,
                    "desc": clean_desc,
                    "source": "Arch Linux"
                })
    except Exception as e:
        print(f"{GRAY}  [!] No se pudo consultar el feed de Arch Linux ({e}){RESET}")
    return news_items

def get_last_read_news():
    if os.path.exists(LAST_NEWS_FILE):
        try:
            with open(LAST_NEWS_FILE, "r") as f:
                return f.read().strip()
        except:
            return ""
    return ""

def save_last_read_news(latest_title):
    os.makedirs(STATE_DIR, exist_ok=True)
    try:
        with open(LAST_NEWS_FILE, "w") as f:
            f.write(latest_title)
    except:
        pass

def check_news():
    print(f"{CYAN}==> [1/5] Verificando noticias oficiales de Arch Linux y CachyOS...{RESET}")
    news = fetch_arch_news()
    if not news:
        print(f"{GRAY}  ✓ No se pudieron obtener noticias (se continuará normalmente).{RESET}\n")
        return True

    last_read = get_last_read_news()
    unread_news = []
    
    for item in news:
        if item["title"] == last_read:
            break
        unread_news.append(item)
    
    # If first run or no last read recorded, show latest 2 news items
    if not last_read and news:
        unread_news = news[:2]

    if not unread_news:
        print(f"{GREEN}  ✓ Sin noticias críticas pendientes en Arch Linux.{RESET}\n")
        return True

    print(f"\n{AMBER}  ┌── 📢 NOTICIAS RECIENTES DE ARCH LINUX ──────────────────────────┐{RESET}")
    for idx, item in enumerate(unread_news, 1):
        is_critical = any(kw in item["title"].lower() for kw in ["manual", "intervention", "incident", "warning", "breaking", "caution"])
        badge = f"{RED}🚨 [INTERVENCIÓN MANUAL]{RESET} " if is_critical else ""
        print(f"  {RED}│{RESET} {BOLD}{idx}. {badge}{WHITE}{item['title']}{RESET}")
        print(f"  {RED}│{RESET}    {GRAY}📅 Fecha:{RESET} {item['date']}")
        print(f"  {RED}│{RESET}    {GRAY}🔗 Enlace:{RESET} {CYAN}{item['link']}{RESET}")
        if is_critical and item["desc"]:
            desc_snippet = item["desc"][:240] + ("..." if len(item["desc"]) > 240 else "")
            print(f"  {RED}│{RESET}    {AMBER}ℹ Resumen:{RESET} {desc_snippet}")
        print(f"  {RED}│{RESET}")
    print(f"{AMBER}  └─────────────────────────────────────────────────────────────────┘{RESET}\n")

    while True:
        choice = input(f"{BOLD}¿Deseas continuar con la actualización? [{GREEN}S{RESET}/n/v para ver detalle completo]: ").strip().lower()
        if choice in ["s", "y", ""]:
            if news:
                save_last_read_news(news[0]["title"])
            return True
        elif choice == "n":
            print(f"\n{RED}✖ Actualización cancelada por el usuario.{RESET}")
            return False
        elif choice == "v":
            for item in unread_news:
                print(f"\n{BOLD}{CYAN}=== {item['title']} ==={RESET}")
                print(f"{GRAY}Fecha: {item['date']}{RESET}")
                print(f"{GRAY}URL: {item['link']}{RESET}\n")
                print(f"{item['desc']}\n")
        else:
            print("Opción inválida. Usa 's' para continuar, 'n' para cancelar, 'v' para ver más.")

def check_pending_updates():
    print(f"{CYAN}==> [2/5] Comprobando paquetes desactualizados...{RESET}")
    official_count = 0
    aur_count = 0
    critical_pkgs = []

    # Check official packages
    try:
        res = subprocess.run(["checkupdates"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        if res.returncode == 0 and res.stdout.strip():
            lines = res.stdout.strip().split("\n")
            official_count = len(lines)
            for l in lines:
                pkg_name = l.split()[0]
                if pkg_name in ["linux-cachyos", "linux", "systemd", "glibc", "sway", "waybar", "nvidia", "mesa"]:
                    critical_pkgs.append(l)
    except:
        pass

    # Check AUR packages if yay is installed
    if subprocess.run(["which", "yay"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        try:
            res_aur = subprocess.run(["yay", "-Qua"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
            if res_aur.returncode == 0 and res_aur.stdout.strip():
                aur_count = len(res_aur.stdout.strip().split("\n"))
        except:
            pass

    total = official_count + aur_count
    if total == 0:
        print(f"{GREEN}  ✓ El sistema ya está 100% actualizado. No hay paquetes pendientes.{RESET}\n")
    else:
        print(f"  {WHITE}• Paquetes oficiales pendientes:{RESET} {AMBER}{official_count}{RESET}")
        if aur_count > 0:
            print(f"  {WHITE}• Paquetes de AUR pendientes:{RESET} {AMBER}{aur_count}{RESET}")
        if critical_pkgs:
            print(f"\n  {RED}⚠ Paquetes del núcleo/críticos detectados en la actualización:{RESET}")
            for cp in critical_pkgs:
                print(f"    {AMBER}→ {cp}{RESET}")
    print()
    return total

def ask_mirrors():
    print(f"{CYAN}==> [3/5] Optimización de servidores espejo (Mirrors)...{RESET}")
    if subprocess.run(["which", "cachyos-rate-mirrors"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        ans = input(f"{BOLD}¿Deseas clasificar y acelerar mirrors con cachyos-rate-mirrors? [s/{GREEN}N{RESET}]: ").strip().lower()
        if ans in ["s", "y"]:
            print(f"\n{AMBER}Optimizando lista de espejos de CachyOS...{RESET}")
            subprocess.run(["sudo", "cachyos-rate-mirrors"])
            print()
    else:
        print(f"{GRAY}  (cachyos-rate-mirrors no disponible, omitiendo).{RESET}\n")

def run_update():
    print(f"{CYAN}==> [4/5] Aplicando actualización completa del sistema...{RESET}")
    has_yay = subprocess.run(["which", "yay"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    
    if has_yay:
        cmd = ["yay", "-Syu"]
    else:
        cmd = ["sudo", "pacman", "-Syu"]
        
    print(f"  {GRAY}Ejecutando: {' '.join(cmd)}{RESET}\n")
    ret = subprocess.run(cmd)
    print()
    return ret.returncode == 0

def post_maintenance():
    print(f"{CYAN}==> [5/5] Tareas de post-actualización y verificación...{RESET}")
    
    # 1. Check for .pacnew / .pacsave files
    print(f"  {WHITE}• Comprobando archivos de configuración .pacnew / .pacsave...{RESET}")
    pacnew_files = []
    try:
        res = subprocess.run(["find", "/etc", "-name", "*.pacnew", "-o", "-name", "*.pacsave"], 
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        if res.stdout.strip():
            pacnew_files = res.stdout.strip().split("\n")
    except:
        pass

    if pacnew_files:
        print(f"\n    {AMBER}⚠ Se encontraron archivos .pacnew que requieren revisión:{RESET}")
        for pf in pacnew_files:
            print(f"      {RED}→{RESET} {pf}")
        print(f"    {GRAY}Puedes gestionarlos ejecutando: {CYAN}DIFFPROG=micro pacdiff{RESET}\n")
    else:
        print(f"    {GREEN}✓ No hay archivos .pacnew pendientes.{RESET}")

    # 2. Check running kernel vs disk kernel
    try:
        running_kernel = subprocess.check_output(["uname", "-r"], text=True).strip()
        print(f"  {WHITE}• Kernel en ejecución:{RESET} {CYAN}{running_kernel}{RESET}")
        
        # Check if modules for running kernel still exist
        modules_path = f"/usr/lib/modules/{running_kernel}"
        if not os.path.exists(modules_path):
            print(f"\n    {RED}🚨 ATENCIÓN: El kernel se ha actualizado y los módulos antiguos fueron reemplazados.{RESET}")
            print(f"    {AMBER}👉 Se recomienda REINICIAR el equipo para aplicar la nueva versión del kernel.{RESET}\n")
    except:
        pass

    # 3. Refresh Waybar updates counter
    try:
        subprocess.run(["pkill", "-RTMIN+8", "waybar"], stderr=subprocess.DEVNULL)
    except:
        pass

    # 4. Desktop Notification
    try:
        subprocess.run(["notify-send", "-a", "System Update", "🛡️ Sistema Actualizado", 
                        "La actualización y verificación de seguridad han concluido con éxito."], stderr=subprocess.DEVNULL)
    except:
        pass

    print(f"\n{GREEN}╔════════════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{GREEN}║           ¡SISTEMA COMPLETAMENTE ACTUALIZADO Y SEGURO!         ║{RESET}")
    print(f"{GREEN}╚════════════════════════════════════════════════════════════════════════╝{RESET}\n")

def main():
    print_banner()
    if not check_news():
        sys.exit(1)
    
    total = check_pending_updates()
    if total == 0:
        opt = input(f"{BOLD}¿Deseas forzar sincronización de repositorios de todas formas? [s/{GREEN}N{RESET}]: ").strip().lower()
        if opt not in ["s", "y"]:
            print(f"\n{GREEN}Sistema al día. Nada que hacer.{RESET}")
            sys.exit(0)
            
    ask_mirrors()
    
    if run_update():
        post_maintenance()
    else:
        print(f"\n{RED}✖ La actualización no se completó debido a un error.{RESET}")
        sys.exit(1)

if __name__ == "__main__":
    main()
