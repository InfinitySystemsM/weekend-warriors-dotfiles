#!/usr/bin/env bash
# Quick check of pending updates for Waybar
if command -v checkupdates >/dev/null 2>&1; then
    COUNT=$(checkupdates 2>/dev/null | wc -l)
    if [ "$COUNT" -gt 0 ]; then
        echo "{\"text\": \"󰚰  $COUNT\", \"tooltip\": \"$COUNT actualizaciones pendientes\\nClic para actualizar\", \"class\": \"pending\"}"
    else
        echo "{\"text\": \"󰚰  0\", \"tooltip\": \"Sistema al día (0 pendientes)\", \"class\": \"updated\"}"
    fi
else
    echo "{\"text\": \"󰚰  ok\", \"tooltip\": \"checkupdates no disponible\", \"class\": \"updated\"}"
fi
